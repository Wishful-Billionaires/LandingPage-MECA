<mjml>
  <mj-head>
    <mj-title>MECA — You're on the list</mj-title>
    <mj-attributes>
      <mj-all font-family="'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-section background-color="#080808" />
      <mj-text color="#999999" font-size="15px" line-height="1.7" />
    </mj-attributes>
  </mj-head>

  <mj-body>
    <mj-section padding="40px 24px">
      <mj-column>
        <mj-text align="center" padding="0 0 24px" color="#ffffff">
          <span style="font-size:20px; font-weight:900; letter-spacing:0.12em;">MECA</span>
        </mj-text>
        <mj-text align="center" color="#ffffff" font-size="26px" font-weight="700" line-height="1.3" padding="0 0 12px">
          You're on the list, {DATA_VARIABLE:name}.
        </mj-text>
        <mj-text align="center" padding="0 0 24px">
          MECA launches in Lisbon soon. We'll let you know when the doors open.
        </mj-text>
        <mj-text align="center" color="#666666" font-size="13px">
          <span style="color:#ffffff; font-weight:700;">Connect. Play. Get Paid.</span>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
