# Supabase project URL (Settings -> API -> Project URL)
SUPABASE_URL="https://xxxxx.supabase.co"

# Supabase service_role key (Settings -> API -> service_role) - SECRET, server-only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY="MY_SERVICE_ROLE_KEY"

# Origin allowed to call this API (the frontend's domain)
ALLOWED_ORIGIN="https://meca-app.com"

# Port the Express server listens on inside the container
PORT=3001
