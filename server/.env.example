# Supabase project URL (Settings -> API -> Project URL)
SUPABASE_URL="https://xxxxx.supabase.co"

# Supabase service_role key (Settings -> API -> service_role) - SECRET, server-only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY="MY_SERVICE_ROLE_KEY"

# Origin(s) allowed to call this API (the frontend's domain). Comma-separated for multiple.
ALLOWED_ORIGIN="https://meca-app.com,https://www.meca-app.com"

# Loops (contact creation triggers the signup workflow) - Settings -> API -> Generate key
LOOPS_API_KEY="MY_LOOPS_API_KEY"

# Port the Express server listens on inside the container
PORT=3001
